{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalDock",
  "version": "0.1.7",
  "identifier": "cn.localdock.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build:web",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "LocalDock",
        "width": 1100,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
